export function minutesToPollingIntervalSeconds(value) {
  if (value === null || value === undefined || value === '') return null

  const minutes = Number(value)
  if (!Number.isFinite(minutes) || minutes <= 0) return null

  const seconds = Math.round(minutes * 60)
  return Number.isSafeInteger(seconds) && seconds > 0 ? seconds : null
}

export function pollingIntervalSecondsToMinutes(value) {
  if (value === null || value === undefined || value === '') return null

  const seconds = Number(value)
  if (!Number.isFinite(seconds) || seconds <= 0) return null

  return seconds / 60
}

export function formatPollingIntervalSeconds(value) {
  const minutes = pollingIntervalSecondsToMinutes(value)

  if (minutes === null) return '—'

  return `${minutes.toLocaleString('ru-RU', {
    maximumFractionDigits: 2,
  })} мин.`
}